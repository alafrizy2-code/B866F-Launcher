<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#020F1E">

    <ImageView
        android:id="@+id/wallpaperView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:background="#020F1E" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#660B1222" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/sideBarContainer"
            android:layout_width="220dp"
            android:layout_height="match_parent"
            android:background="#1A1730"
            android:orientation="vertical"
            android:paddingTop="28dp"
            android:paddingBottom="24dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:translationX="-220dp"
            android:alpha="0.0">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Menu"
                android:textColor="@android:color/white"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginBottom="18dp" />

            <Button
                android:id="@+id/btnHome"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Home"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:gravity="start|center_vertical"
                android:background="@drawable/side_button_bg"
                android:paddingStart="14dp"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btnManageFavorites"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Kelola Favorit"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:gravity="start|center_vertical"
                android:background="@drawable/side_button_bg"
                android:paddingStart="14dp"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btnTheme"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Tema"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:gravity="start|center_vertical"
                android:background="@drawable/side_button_bg"
                android:paddingStart="14dp"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btnWallpaper"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Wallpaper"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:gravity="start|center_vertical"
                android:background="@drawable/side_button_bg"
                android:paddingStart="14dp"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btnSettings"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Pengaturan"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:gravity="start|center_vertical"
                android:background="@drawable/side_button_bg"
                android:paddingStart="14dp"
                android:layout_marginBottom="8dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/btnHideSidebar"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Sembunyikan"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:gravity="center"
                android:background="@drawable/side_button_bg" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingTop="24dp"
            android:paddingEnd="28dp"
            android:paddingBottom="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/btnSidebarToggle"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_icon"
                        android:src="@drawable/ic_menu"
                        android:contentDescription="Toggle menu"
                        app:tint="@android:color/white" />

                    <ImageView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_marginStart="12dp"
                        android:background="@drawable/bg_logo"
                        android:padding="8dp"
                        android:src="@drawable/ic_tv" />

                    <TextView
                        android:id="@+id/appBrand"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="B866F Launcher"
                        android:textColor="@android:color/white"
                        android:textSize="28sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/timeText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="10dp"
                        android:text="19:42"
                        android:textColor="@android:color/white"
                        android:textSize="30sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@drawable/ic_weather"
                        app:tint="@android:color/white" />

                    <TextView
                        android:id="@+id/tempText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="28°C"
                        android:textColor="@android:color/white"
                        android:textSize="24sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingTop="32dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Selamat datang"
                    android:textColor="#DCE6FF"
                    android:textSize="28sp" />

                <TextView
                    android:id="@+id/heroText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Nikmati hiburan favoritmu"
                    android:textColor="@android:color/white"
                    android:textSize="40sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Aplikasi, Live TV, dan banyak lagi — semua dalam satu tempat."
                    android:textColor="@android:color/white"
                    android:textSize="18sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:text="Aplikasi Favorit"
                android:textColor="@android:color/white"
                android:textSize="24sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/favoriteRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="horizontal"
                android:paddingTop="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OK"
                    android:textColor="@android:color/white"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text=": Buka"
                    android:textColor="#D8E8FF"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="36dp"
                    android:text="Kembali"
                    android:textColor="#D8E8FF"
                    android:textSize="18sp" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</FrameLayout>
